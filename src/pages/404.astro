---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title={"Page Not Found | \\blackslash\\"}
  description="The page you're looking for doesn't exist."
>
  <section class="min-h-[70vh] flex items-center justify-center">
    <div class="container-custom text-center">
      <!-- 404 Number -->
      <div class="mb-8">
        <span class="text-8xl md:text-9xl font-bold text-primary-gray-200">404</span>
      </div>
      
      <!-- Message -->
      <h1 class="heading-2 mb-4">
        Page Not Found
      </h1>
      
      <p class="body-large max-w-md mx-auto mb-8">
        The page you're looking for doesn't exist or has been moved.
      </p>
      
      <!-- Actions -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn-primary">
          Go Home
        </a>
        <a href="/products" class="btn-secondary">
          View Products
        </a>
      </div>
      
      <!-- Decorative element -->
      <div class="mt-16 flex items-center justify-center gap-2 text-primary-gray-300">
        <span class="w-8 h-px bg-primary-gray-300"></span>
        <span class="text-sm">\blackslash\</span>
        <span class="w-8 h-px bg-primary-gray-300"></span>
      </div>
    </div>
  </section>
</Layout>
